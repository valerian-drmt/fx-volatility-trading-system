{
 "$defs": {
  "CalibrationConfig": {
   "description": "Walk-forward + backtest calibration hyperparameters.",
   "properties": {
    "ewma_lambda_fair_smile": {
     "default": 0.94,
     "maximum": 0.999,
     "minimum": 0.5,
     "title": "Ewma Lambda Fair Smile",
     "type": "number"
    },
    "har_components": {
     "default": [
      1,
      5,
      22
     ],
     "maxItems": 3,
     "minItems": 3,
     "prefixItems": [
      {
       "type": "integer"
      },
      {
       "type": "integer"
      },
      {
       "type": "integer"
      }
     ],
     "title": "Har Components",
     "type": "array"
    },
    "vrp_mae_improvement_threshold": {
     "default": 0.2,
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Vrp Mae Improvement Threshold",
     "type": "number"
    },
    "vrp_train_split": {
     "default": 0.7,
     "maximum": 0.9,
     "minimum": 0.5,
     "title": "Vrp Train Split",
     "type": "number"
    },
    "w1_clip_max": {
     "default": 1.0,
     "maximum": 1.0,
     "minimum": 0.5,
     "title": "W1 Clip Max",
     "type": "number"
    },
    "w1_clip_min": {
     "default": 0.0,
     "maximum": 0.5,
     "minimum": 0.0,
     "title": "W1 Clip Min",
     "type": "number"
    },
    "w1_walk_forward_months": {
     "default": 12,
     "maximum": 36,
     "minimum": 3,
     "title": "W1 Walk Forward Months",
     "type": "integer"
    }
   },
   "title": "CalibrationConfig",
   "type": "object"
  },
  "CapacityConfig": {
   "description": "The capacity dial: cadence, window, thread cap and chain-scan width of\nthe cold path, hot-reloaded over ``config:changed`` (#371 / #372).\n\nThe analytics engine reads ``analytics_interval_min``,\n``training_window_days``, ``thread_cap`` (BLAS / scikit-learn threads via\n``threadpoolctl``), ``pca_snapshot_interval_min`` and ``rollup_interval_s``\nat the start of each cycle; the vol engine reads ``strikes_per_side`` and\n``max_concurrent_scans`` on every chain fetch (wing coverage against IB\nGateway load: ``docs/vol-modeling/volatility-surface.md``).",
   "properties": {
    "analytics_interval_min": {
     "default": 60,
     "maximum": 1440,
     "minimum": 5,
     "title": "Analytics Interval Min",
     "type": "integer"
    },
    "max_concurrent_scans": {
     "default": 1,
     "maximum": 4,
     "minimum": 1,
     "title": "Max Concurrent Scans",
     "type": "integer"
    },
    "pca_snapshot_interval_min": {
     "default": 60,
     "maximum": 1440,
     "minimum": 1,
     "title": "Pca Snapshot Interval Min",
     "type": "integer"
    },
    "preset": {
     "default": "balanced",
     "enum": [
      "eco",
      "balanced",
      "full",
      "custom"
     ],
     "title": "Preset",
     "type": "string"
    },
    "rollup_interval_s": {
     "default": 300,
     "maximum": 3600,
     "minimum": 30,
     "title": "Rollup Interval S",
     "type": "integer"
    },
    "strikes_per_side": {
     "default": 18,
     "maximum": 40,
     "minimum": 6,
     "title": "Strikes Per Side",
     "type": "integer"
    },
    "thread_cap": {
     "default": 1,
     "maximum": 8,
     "minimum": 1,
     "title": "Thread Cap",
     "type": "integer"
    },
    "training_window_days": {
     "default": 90,
     "maximum": 365,
     "minimum": 14,
     "title": "Training Window Days",
     "type": "integer"
    }
   },
   "title": "CapacityConfig",
   "type": "object"
  },
  "DeltaHedgeConfig": {
   "description": "Delta hedging behavior : static / threshold / scheduled.",
   "properties": {
    "mode": {
     "default": "threshold",
     "enum": [
      "static",
      "threshold",
      "scheduled"
     ],
     "title": "Mode",
     "type": "string"
    },
    "scheduled_interval_minutes": {
     "default": 60,
     "maximum": 1440,
     "minimum": 5,
     "title": "Scheduled Interval Minutes",
     "type": "integer"
    },
    "threshold_delta": {
     "default": 0.05,
     "maximum": 0.5,
     "minimum": 0.01,
     "title": "Threshold Delta",
     "type": "number"
    }
   },
   "title": "DeltaHedgeConfig",
   "type": "object"
  },
