# Local stack without AWS (#351). Copy to `.env` (gitignored) and fill in:
#
#   cp .env.example .env          # PowerShell: Copy-Item .env.example .env
#   docker compose up -d --build
#   docker compose exec api python -m alembic -c src/persistence/alembic.ini upgrade head
#
# docker compose reads `.env` from the repo root on its own; `scripts/local/stack.ps1`
# skips the AWS SSM loader when this file sets DB_PASSWORD. Values here are for a
# laptop only: prod reads every secret from SSM on the host (docs/ops/secrets.md).

# --- required -------------------------------------------------------------------
# Postgres password for the `fxvol` role (any value; the volume keeps the first one).
DB_PASSWORD=change-me-local

# --- optional: everything below has a working default ------------------------------
# Redis password (default fxvol-dev).
# REDIS_PASSWORD=change-me-local

# Write access to the desk (orders, config). Reads are public; without a hash the
# login stays closed. User `trader`; hash with the default salt `fxvol`:
#   PYTHONPATH=src python -c "from api.auth import hash_password; print(hash_password('your-password', 'fxvol'))"
# AUTH_SECRET=<any long random string>
# AUTH_PASSWORD_HASH=<the hex the command prints>

# IB paper account, only for `--profile ib` (the IB Gateway container). Without an
# IB account the desk runs on the core stack: api, frontend, nginx, postgres, redis.
# One IB session per user id: a portal or mobile login kicks the gateway.
IB_USERID=
IB_PASSWORD=
VNC_PASSWORD=change-me-local
# yes = the gateway refuses order placement (reads still work); no = paper orders allowed.
# READ_ONLY_API=yes

# FRED calendar for the events pipeline (free key from fred.stlouisfed.org).
# FRED_API_KEY=

# Grafana admin, only for `--profile obs`.
# GRAFANA_ADMIN_PASSWORD=change-me-local
